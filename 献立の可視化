                    { id: 121, qty: 30 },   // みりん
                    { id: 55, qty: 0.3 }    // キャベツ
                ]
            },
            {
                id: 'bento',
                title: '幕の内風お弁当',
                icon: 'fa-box-archive',
                color: 'from-blue-500 to-indigo-600',
                items: [
                    { id: 1, qty: 600 },    // 米
                    { id: 36, qty: 2 },     // 塩サケ
                    { id: 21, qty: 200 },   // 鶏もも肉（から揚げ用）
                    { id: 87, qty: 2 },     // 卵（玉子焼き用）
                    { id: 141, qty: 1 },    // 漬物
                    { id: 79, qty: 1 }      // 焼きのり
                ]
            }
        ];

        let state = {
            cart: [
                { id: 52, qty: 300 }, // じゃがいも 300g
                { id: 54, qty: 200 }, // にんじん 200g
                { id: 53, qty: 300 }, // たまねぎ 300g
                { id: 16, qty: 250 }  // 牛肉 250g
            ],
            servings: 4,
            currentCategory: 'すべて',
            searchQuery: '',
            activeChartTab: 'pie'
        };

        let categoryChartInstance = null;
        let trendChartInstance = null;

        window.addEventListener('DOMContentLoaded', () => {
            initCategoryTabs();
            initPresetButtons();
            renderFoodGrid();
            renderCart();
            setupEventListeners();
        });

        function initCategoryTabs() {
            const categories = ['すべて', '穀類', '肉類', '魚介類', '野菜', '乳卵類', '果物', '調味料', '加工食品', '飲料・菓子'];
            const container = document.getElementById('category-tabs');
            
            container.innerHTML = categories.map(cat => {
                const isActive = cat === state.currentCategory;
                const activeClass = isActive 
                    ? 'bg-orange-500 text-white font-bold shadow-sm' 
                    : 'bg-slate-100 text-slate-600 hover:bg-slate-200 font-medium';
                return `<button onclick="selectCategory('${cat}')" class="px-3 py-1.5 rounded-lg whitespace-nowrap transition-all ${activeClass}">${cat}</button>`;
            }).join('');
        }

        function initPresetButtons() {
            const container = document.getElementById('preset-buttons');
            container.innerHTML = PRESET_RECIPES.map(p => `
                <button onclick="loadPreset('${p.id}')" 
                    class="flex flex-col items-center justify-center p-2.5 rounded-xl border border-slate-200 bg-white hover:border-orange-400 hover:shadow-md transition text-center group">
                    <div class="w-8 h-8 rounded-lg bg-gradient-to-br ${p.color} text-white flex items-center justify-center mb-1.5 shadow-sm group-hover:scale-105 transition-transform">
                        <i class="fa-solid ${p.icon} text-sm"></i>
                    </div>
                    <span class="text-xs font-bold text-slate-800 line-clamp-1">${p.title}</span>
                </button>
            `).join('');
        }

        function setupEventListeners() {
            document.getElementById('search-input').addEventListener('input', (e) => {
                state.searchQuery = e.target.value.trim().toLowerCase();
                renderFoodGrid();
            });

            document.getElementById('servings-select').addEventListener('change', (e) => {
                state.servings = parseInt(e.target.value, 10);
                renderCart();
                showToast(`人数分を ${state.servings}人分 に変更しました`, 'info');
            });
        }

        function selectCategory(cat) {
            state.currentCategory = cat;
            initCategoryTabs();
            renderFoodGrid();
        }

        function renderFoodGrid() {
            const grid = document.getElementById('food-items-grid');
            
            const filtered = FOOD_ITEMS.filter(item => {
                const matchCat = state.currentCategory === 'すべて' || item.cat === state.currentCategory;
                const matchSearch = !state.searchQuery || 
                    item.name.toLowerCase().includes(state.searchQuery) || 
                    item.cat.toLowerCase().includes(state.searchQuery);
                return matchCat && matchSearch;
            });

            document.getElementById('item-count-badge').textContent = filtered.length;

            if (filtered.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full py-10 text-center text-slate-400">
                        <i class="fa-solid fa-magnifying-glass-minus text-3xl mb-2"></i>
                        <p class="text-xs">該当する食材が見つかりませんでした</p>
                    </div>`;
                return;
            }

            grid.innerHTML = filtered.map(item => {
                const inCart = state.cart.find(c => c.id === item.id);
                const price2020 = Math.round(item.base2020 * item.stdQty);
                const price2026 = Math.round(item.cpi2026 * item.stdQty);
                const ratio = Math.round(((price2026 - price2020) / price2020) * 100);

                return `
                    <div class="p-3 rounded-xl border ${inCart ? 'border-orange-400 bg-orange-50/40' : 'border-slate-200 bg-white hover:border-slate-300'} transition flex flex-col justify-between">
                        <div>
                            <div class="flex items-start justify-between gap-1 mb-1">
                                <span class="text-[10px] font-semibold px-2 py-0.5 rounded bg-slate-100 text-slate-600">${item.cat}</span>
                                <span class="text-[11px] font-bold ${ratio >= 30 ? 'text-rose-600 bg-rose-50 px-1.5 rounded' : 'text-orange-600'}">+${ratio}%</span>
                            </div>
                            <h4 class="font-bold text-xs text-slate-800 line-clamp-1 mb-1" title="${item.name}">${item.name}</h4>
                            <p class="text-[11px] text-slate-500">標準単価基準: ${item.stdQty}${item.unit}</p>
                        </div>
                        
                        <div class="mt-2.5 pt-2 border-t border-slate-100 flex items-center justify-between">
                            <div class="text-[11px]">
                                <span class="text-slate-400 line-through mr-1">¥${price2020}</span>
                                <span class="font-bold text-slate-900">¥${price2026}</span>
                            </div>
                            
                            <button onclick="toggleCartItem(${item.id})" 
                                class="px-2.5 py-1 text-xs rounded-lg font-semibold transition ${inCart ? 'bg-rose-100 text-rose-700 hover:bg-rose-200' : 'bg-orange-500 text-white hover:bg-orange-600 shadow-sm'}">
                                ${inCart ? '<i class="fa-solid fa-check"></i> 選択中' : '<i class="fa-solid fa-plus"></i> 追加'}
                            </button>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function toggleCartItem(id) {
            const index = state.cart.findIndex(c => c.id === id);
            const item = FOOD_ITEMS.find(f => f.id === id);

            if (index > -1) {
                state.cart.splice(index, 1);
                showToast(`「${item.name}」を献立から削除しました`, 'remove');
            } else {
                state.cart.push({ id: id, qty: item.stdQty });
                showToast(`「${item.name}」を献立に追加しました`, 'add');
            }

            renderFoodGrid();
            renderCart();
        }

        function updateItemQuantity(id, newQty) {
            const qty = parseFloat(newQty);
            if (isNaN(qty) || qty <= 0) return;

            const cartItem = state.cart.find(c => c.id === id);
            if (cartItem) {
                cartItem.qty = qty;
                renderCart();
            }
        }

        function removeFromCart(id) {
            state.cart = state.cart.filter(c => c.id !== id);
            renderFoodGrid();
            renderCart();
            showToast('食材を削除しました', 'remove');
        }

        function loadPreset(presetId) {
            const preset = PRESET_RECIPES.find(p => p.id === presetId);
            if (!preset) return;

            state.cart = preset.items.map(i => ({ ...i }));
            renderFoodGrid();
            renderCart();
            showToast(`定番メニュー「${preset.title}」を読み込みました！`, 'success');
        }

        function resetAll() {
            state.cart = [];
            state.servings = 4;
            document.getElementById('servings-select').value = '4';
            renderFoodGrid();
            renderCart();
            showToast('献立をクリアしました', 'info');
        }

        function renderCart() {
            const emptyMsg = document.getElementById('cart-empty-msg');
            const content = document.getElementById('cart-content');
            const tbody = document.getElementById('cart-items-tbody');

            if (state.cart.length === 0) {
                emptyMsg.classList.remove('hidden');
                content.classList.add('hidden');
                return;
            }

            emptyMsg.classList.add('hidden');
            content.classList.remove('hidden');

            let total2020 = 0;
            let total2026 = 0;
            const categoryBreakdown = {};

            const rowsHtml = state.cart.map(c => {
                const item = FOOD_ITEMS.find(f => f.id === c.id);
                if (!item) return '';

                const cost2020 = item.base2020 * c.qty * (state.servings / 4);
                const cost2026 = item.cpi2026 * c.qty * (state.servings / 4);

                total2020 += cost2020;
                total2026 += cost2026;

                categoryBreakdown[item.cat] = (categoryBreakdown[item.cat] || 0) + cost2026;

                return `
                    <tr class="hover:bg-slate-50 transition">
                        <td class="p-2.5 font-medium text-slate-800">
                            <div>${item.name}</div>
                            <span class="text-[10px] text-slate-400 font-normal">${item.cat}</span>
                        </td>
                        <td class="p-2.5 text-center">
                            <div class="flex items-center justify-center space-x-1">
                                <input type="number" min="0.1" step="any" value="${c.qty}" 
                                    onchange="updateItemQuantity(${item.id}, this.value)"
                                    class="w-14 text-center border border-slate-200 rounded px-1 py-0.5 text-xs focus:ring-1 focus:ring-orange-500 focus:outline-none">
                                <span class="text-[11px] text-slate-500">${item.unit}</span>
                            </div>
                        </td>
                        <td class="p-2.5 text-right font-medium text-slate-500">¥${Math.round(cost2020)}</td>
                        <td class="p-2.5 text-right font-bold text-slate-900">¥${Math.round(cost2026)}</td>
                        <td class="p-2.5 text-center">
                            <button onclick="removeFromCart(${item.id})" class="text-slate-400 hover:text-rose-500 transition px-1 py-0.5">
                                <i class="fa-solid fa-xmark text-sm"></i>
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');

            tbody.innerHTML = rowsHtml;

            // Summary Totals Calculation
            const diffPrice = total2026 - total2020;
            const diffPercent = total2020 > 0 ? ((diffPrice / total2020) * 100).toFixed(1) : '0.0';
            const perServing = Math.round(total2026 / state.servings);

            document.getElementById('total-2020').textContent = `¥${Math.round(total2020).toLocaleString()}`;
            document.getElementById('total-2026').textContent = `¥${Math.round(total2026).toLocaleString()}`;
            document.getElementById('diff-price').textContent = `+¥${Math.round(diffPrice).toLocaleString()}`;
            document.getElementById('diff-percent').textContent = `+${diffPercent}%`;
            document.getElementById('per-serving-cost').textContent = `¥${perServing.toLocaleString()}`;

            // Update Dynamic Analysis Tip
            updateAnalysisTip(categoryBreakdown, total2026);

            // Render Charts
            renderCategoryPieChart(categoryBreakdown);
            renderTrendChart(total2020, total2026);
        }

        function updateAnalysisTip(breakdown, total2026) {
            if (!total2026 || Object.keys(breakdown).length === 0) return;

            let topCat = '';
            let maxVal = 0;
            for (const [cat, val] of Object.entries(breakdown)) {
                if (val > maxVal) {
                    maxVal = val;
                    topCat = cat;
                }
            }

            const pct = Math.round((maxVal / total2026) * 100);
            document.getElementById('analysis-tip').innerHTML = 
                `現在の献立では <strong class="text-orange-600">${topCat}</strong> が全体の <strong class="text-orange-600">${pct}%</strong> (¥${Math.round(maxVal).toLocaleString()}) を占めています。`;
        }

        function renderCategoryPieChart(breakdown) {
            const ctx = document.getElementById('categoryChart').getContext('2d');

            if (categoryChartInstance) {
                categoryChartInstance.destroy();
            }

            const labels = Object.keys(breakdown);
            const data = Object.values(breakdown);

            categoryChartInstance = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: data,
                        backgroundColor: [
                            '#f97316', '#3b82f6', '#10b981', '#f59e0b', 
                            '#8b5cf6', '#ec4899', '#14b8a6', '#64748b'
                        ],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'right',
                            labels: {
                                boxWidth: 12,
                                font: { size: 10, family: 'Noto Sans JP' }
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return ` ${context.label}: ¥${Math.round(context.raw)}`;
                                }
                            }
                        }
                    }
                }
            });
        }

        function renderTrendChart(total2020, total2026) {
            const ctx = document.getElementById('trendChart').getContext('2d');

            if (trendChartInstance) {
                trendChartInstance.destroy();
            }

            // Estimate annual trend curve based on CPI trajectories
            const years = ['2020年', '2022年', '2024年', '2026年'];
            const trendData = [
                Math.round(total2020),
                Math.round(total2020 * 1.06),
                Math.round(total2020 * 1.18),
                Math.round(total2026)
            ];

            trendChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: years,
                    datasets: [{
                        label: '献立推計価格 (円)',
                        data: trendData,
                        borderColor: '#ea580c',
                        backgroundColor: 'rgba(234, 88, 12, 0.1)',
                        fill: true,
                        tension: 0.3,
                        pointBackgroundColor: '#c2410c',
                        pointRadius: 5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: (ctx) => ` ¥${ctx.raw.toLocaleString()}`
                            }
                        }
                    },
                    scales: {
                        y: {
                            ticks: {
                                font: { size: 10 },
                                callback: (val) => '¥' + val
                            }
                        },
                        x: {
                            ticks: { font: { size: 10 } }
                        }
                    }
                }
            });
        }

        function switchChartTab(tab) {
            state.activeChartTab = tab;
            const btn1 = document.getElementById('btn-tab-chart1');
            const btn2 = document.getElementById('btn-tab-chart2');
            const c1 = document.getElementById('chart-pie-container');
            const c2 = document.getElementById('chart-trend-container');

            if (tab === 'pie') {
                btn1.className = 'px-2.5 py-1 text-xs rounded-md font-semibold bg-orange-100 text-orange-700';
                btn2.className = 'px-2.5 py-1 text-xs rounded-md font-semibold bg-slate-100 text-slate-600';
                c1.classList.remove('hidden');
                c2.classList.add('hidden');
            } else {
                btn2.className = 'px-2.5 py-1 text-xs rounded-md font-semibold bg-orange-100 text-orange-700';
                btn1.className = 'px-2.5 py-1 text-xs rounded-md font-semibold bg-slate-100 text-slate-600';
                c2.classList.remove('hidden');
                c1.classList.add('hidden');
            }
        }

        function exportRecipe() {
            if (state.cart.length === 0) {
                showToast('保存・出力する食材が選択されていません', 'info');
                return;
            }

            let text = `【献立物価シミュレーター 計算結果】\n`;
            text += `作成日時: ${new Date().toLocaleDateString('ja-JP')}\n`;
            text += `対象人数: ${state.servings}人分\n`;
            text += `----------------------------------------\n`;

            let total2020 = 0;
            let total2026 = 0;

            state.cart.forEach(c => {
                const item = FOOD_ITEMS.find(f => f.id === c.id);
                if (item) {
                    const p2020 = item.base2020 * c.qty * (state.servings / 4);
                    const p2026 = item.cpi2026 * c.qty * (state.servings / 4);
                    total2020 += p2020;
                    total2026 += p2026;
                    text += `・${item.name} (${c.qty}${item.unit}): 2020年 ¥${Math.round(p2020)} → 2026年 ¥${Math.round(p2026)}\n`;
                }
            });

            const diff = total2026 - total2020;
            const pct = ((diff / total2020) * 100).toFixed(1);

            text += `----------------------------------------\n`;
            text += `2020年 合計価格 : ¥${Math.round(total2020).toLocaleString()}\n`;
            text += `2026年 合計価格 : ¥${Math.round(total2026).toLocaleString()}\n`;
            text += `価格上昇額 : +¥${Math.round(diff).toLocaleString()} (+${pct}%)\n`;
            text += `1人あたり (2026年): ¥${Math.round(total2026 / state.servings).toLocaleString()}\n`;

            // Copy to Clipboard
            const textarea = document.createElement('textarea');
            textarea.value = text;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);

            showToast('計算結果をクリップボードにコピーしました！', 'success');
        }

        function showToast(msg, type = 'info') {
            const toast = document.getElementById('toast');
            const messageEl = document.getElementById('toast-message');
            const iconEl = document.getElementById('toast-icon');

            messageEl.textContent = msg;

            if (type === 'add') {
                iconEl.className = 'fa-solid fa-circle-plus text-emerald-400 text-sm';
            } else if (type === 'remove') {
                iconEl.className = 'fa-solid fa-circle-minus text-rose-400 text-sm';
            } else if (type === 'success') {
                iconEl.className = 'fa-solid fa-circle-check text-emerald-400 text-sm';
            } else {
                iconEl.className = 'fa-solid fa-circle-info text-amber-400 text-sm';
            }

            toast.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
            toast.classList.add('opacity-100', 'translate-y-0');

            setTimeout(() => {
                toast.classList.remove('opacity-100', 'translate-y-0');
                toast.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
            }, 2500);
        }
    </script>
</body>
</html>
